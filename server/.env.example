# Copy to .env and fill in. Mode must be 600: chmod 600 .env

# Shared secret with the Vercel app (header X-Automation-Secret)
AUTOMATION_SECRET=replace-with-a-long-random-string

# Google Drive root folder (the one containing the 4 business folders)
ROOT_FOLDER_ID=1SNb5Nby17k988eSygucMJkvedOUzGlkq

# Google Sheet
SHEET_ID=replace-with-the-spreadsheet-id
SHEET_TAB=Sheet1
# RAW keeps "21-Oct-2026" as text; use USER_ENTERED only if the Date column is a real date type
DATE_INPUT_MODE=RAW

# Local paths
DOWNLOAD_DIR=./downloads
CHROME_PROFILE_DIR=./chrome-profile
DB_PATH=./data/jobs.db

# Behaviour
KEEP_FAILED_DAYS=7
CREATE_MISSING_FOLDERS=false
MAX_ROWS_PER_JOB=30
LOG_LEVEL=INFO

# Email reports (Google SMTP app password — smtp.gmail.com, not smtp.google.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_APP_PASSWORD=replace-with-app-password
SMTP_FROM=your@gmail.com
EMAIL_FALLBACK_TO=your@gmail.com

# AI folder routing (GROQ → Gemini → OpenRouter → keyword rules; empty key skips provider)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ROUTING_MIN_CONFIDENCE=0.75
ROUTING_MAX_DEPTH=3
ROUTING_MAX_NODES=300
ROUTING_TIMEOUT_SECONDS=20
ROUTING_MODEL_GROQ=openai/gpt-oss-120b
ROUTING_MODEL_GEMINI=gemini-3.8-flash
ROUTING_MODEL_OPENROUTER=openai/gpt-4o-mini

# Stub-only testing hook (Module 1): make the Nth Drive upload fail. Leave empty in production.
# STUB_FAIL_ON_CALL=2

# Email via Resend (primary). Leave RESEND_API_KEY empty to use SMTP only.
RESEND_API_KEY=
EMAIL_FROM=info@mudasarmajeed5.tech
