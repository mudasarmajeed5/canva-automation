[Unit]
Description=Canva automation server (FastAPI + Playwright worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mudassar
Group=mudassar
WorkingDirectory=/home/mudassar/code/python-automation/canva-automation/server
EnvironmentFile=/home/mudassar/code/python-automation/canva-automation/server/.env
Environment=DISPLAY=:2
Environment=WAYLAND_DISPLAY=
Environment=XDG_SESSION_TYPE=
ExecStart=/home/mudassar/code/python-automation/canva-automation/server/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8473
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
