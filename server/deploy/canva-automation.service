[Unit]
Description=Canva automation server (FastAPI + Playwright worker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=canva-auto
Group=canva-auto
WorkingDirectory=/opt/canva-automation
EnvironmentFile=/opt/canva-automation/.env
# Headed Chrome needs a virtual display; xvfb-run provides one per start.
ExecStart=/usr/bin/xvfb-run -a /opt/canva-automation/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
# The Chrome profile and downloads contain the logged-in Canva session.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
