# Google Cloud OAuth web application credentials.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Auth.js session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret
AUTH_TRUST_HOST=true

# Public URL of the Python FastAPI service.
AUTOMATION_BACKEND_URL=https://events.mudasarmajeed5.tech

# Must match server/.env AUTOMATION_SECRET. Keep this server-side.
AUTOMATION_SECRET=replace-with-the-python-server-secret

# Optional: shown as the "Open Google Sheet" destination when added later.
NEXT_PUBLIC_SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/edit
