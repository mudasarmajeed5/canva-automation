# Copy the relevant values into server/.env and next-canva/.env.local.
# Never commit either real environment file.

# Python service
AUTOMATION_SECRET=replace-with-a-long-random-string
ROOT_FOLDER_ID=replace-with-google-drive-root-folder-id
SHEET_ID=replace-with-google-sheet-id
SHEET_TAB=Sheet1
DATE_INPUT_MODE=RAW
DOWNLOAD_DIR=./downloads
CHROME_PROFILE_DIR=./chrome-profile
DB_PATH=./data/jobs.db

# Next.js / Vercel
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
AUTOMATION_BACKEND_URL=https://events.mudasarmajeed5.tech
NEXT_PUBLIC_SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/edit
